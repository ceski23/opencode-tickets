{
	"name": "@ceski23/opencode-tickets",
	"version": "1.0.1",
	"description": "Local-first Markdown tickets for OpenCode, with agent tools and a terminal ticket tree.",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ceski23/opencode-tickets.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./src/index.ts",
		"./tui": {
			"types": "./dist/tui.d.ts",
			"default": "./dist/tui.js"
		},
		"./rpc": "./src/rpc.ts"
	},
	"files": [
		"src",
		"dist",
		"docs",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:config": "publint",
		"check": "bun run build && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run check:config",
		"release": "bun run check && npx release-it",
		"release:dry": "bun run check && npx release-it --dry-run",
		"prepack": "bun run build",
		"prepublishOnly": "bun run check"
	},
	"dependencies": {
		"fuse.js": "7.5.0",
		"gray-matter": "4.0.3",
		"open": "11.0.4",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"@opencode/plugin": ">=2.2.0",
		"@opentui/core": ">=0.8.1",
		"@opentui/solid": ">=0.8.1",
		"effect": "^4.0.0",
		"solid-js": ">=1.9.0"
	},
	"devDependencies": {
		"@opencode/plugin": "2.3.0",
		"@opencode/theme": "2.3.0",
		"@opentui/core": "0.8.4",
		"@opentui/solid": "0.8.4",
		"@release-it/conventional-changelog": "12.0.2",
		"@types/node": "26.6.6",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"publint": "0.3.25",
		"release-it": "21.1.2",
		"rolldown-plugin-solid": "0.2.1",
		"solid-js": "1.9.19",
		"tsdown": "0.23.7",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
